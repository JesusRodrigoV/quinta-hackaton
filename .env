PROJECT_NAME="Prediction & Rerouting Engine"
VERSION="1.0.0"

# Base de Datos Local (Modifica 'postgres', 'tu_password' y 'tu_base_de_datos' con tus datos reales)
DATABASE_URL=postgresql+asyncpg://postgres:62625054@localhost:5432/KATA20


# Infraestructura Global de Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=prediction_engine_group
KAFKA_TOPIC_TELEMETRY=traffic.telemetry-gps
KAFKA_TOPIC_REROUTE=traffic.reroute-events

# Rutas de Modelos y Analítica (Para las fases de IA)
S3_MOCK_PARQUET_PATH=./data/mock_historical_data.parquet
MODEL_WEIGHTS_PATH=./data/xgb_model.json